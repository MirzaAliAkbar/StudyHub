# copy to .env and fill in
SECRET_KEY=change-me-to-a-random-string
JEV_API_KEY=your-hackclub-key
# optional
JEV_API_URL=https://ai.hackclub.com/proxy/v1/jev/systemone
JEV_MODEL=jev-latest
AUTO_TAG_MIN=0.45
